{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backup Workflow Hosted Agent",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5679
      },
      "preLaunchTask": "Open Backup Workflow Agent Inspector",
      "internalConsoleOptions": "neverOpen",
      "postDebugTask": "Terminate Backup Workflow Tasks"
    }
  ]
}{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
