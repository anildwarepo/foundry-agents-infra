# Local development only. Foundry injects FOUNDRY_PROJECT_ENDPOINT in hosted containers.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4

# Use the local MCP server while developing outside Foundry.
DATA_DISCOVERY_MCP_ENDPOINT=http://localhost:3002/mcp
USE_FOUNDRY_TOOLBOX=false
TOOLBOX_NAME=backup-discovery-tools

FOUNDRY_REQUEST_TIMEOUT_SECONDS=60